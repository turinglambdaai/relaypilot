{
  "cases": [
    {
      "name": "version",
      "args": [
        "version"
      ]
    },
    {
      "name": "usage-no-args",
      "args": []
    },
    {
      "name": "usage-help-flag",
      "args": [
        "--help"
      ]
    },
    {
      "name": "unknown-command",
      "args": [
        "bogus"
      ]
    },
    {
      "name": "validate-ok",
      "args": [
        "validate",
        "{{repo}}/examples/relay-profile.json"
      ]
    },
    {
      "name": "validate-missing-file",
      "args": [
