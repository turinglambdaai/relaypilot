        "imported"
      ]
    },
    {
      "name": "import-surge-missing-id",
      "args": [
        "import-surge",
        "{{repo}}/examples/surge-rules.list"
      ]
    },
    {
      "name": "dry-run-without-engine",
      "args": [
        "dry-run",
        "{{repo}}/examples/relay-profile.json"
      ]
    },
    {
      "name": "diagnose-redacts-and-reports",
      "args": [
        "diagnose",
        "{{repo}}/examples/relay-profile.json",
        "--domain",
        "api.openai.com",
        "--port",
        "443"
      ]
