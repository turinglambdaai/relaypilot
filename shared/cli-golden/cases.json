        "{{work}}/does-not-exist.json"
      ]
    },
    {
      "name": "validate-duplicate-node-ids",
      "args": [
        "validate",
        "{{repo}}/shared/cli-golden/fixtures/bad-profile.json"
      ]
    },
    {
      "name": "validate-malformed-json",
      "args": [
        "validate",
        "{{repo}}/shared/cli-golden/fixtures/malformed.json"
      ]
    },
    {
      "name": "decide-exact-domain",
      "args": [
        "decide",
        "{{repo}}/examples/relay-profile.json",
        "--domain",
        "api.openai.com",
        "--port",
        "443"
      ]
    },
    {
      "name": "decide-final-fallback",
      "args": [
        "decide",
        "{{repo}}/examples/relay-profile.json",
        "--domain",
        "nomatch.example.net",
        "--ip",
        "203.0.113.7",
        "--network",
        "udp"
      ]
    },
    {
      "name": "decide-no-rule-matched",
      "args": [
        "decide",
        "{{repo}}/shared/cli-golden/fixtures/no-final.json",
        "--domain",
        "unmatched.example.net"
      ]
    },
    {
      "name": "decide-missing-flow",
      "args": [
        "decide",
        "{{repo}}/examples/relay-profile.json"
      ]
    },
    {
      "name": "compile-to-stdout",
      "args": [
        "compile",
        "{{repo}}/examples/relay-profile.json"
      ]
    },
    {
      "name": "compile-to-file",
      "args": [
        "compile",
        "{{repo}}/examples/relay-profile.json",
        "--out",
        "{{work}}/config.json"
      ]
